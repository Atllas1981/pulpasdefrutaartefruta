              class="w-11 h-11 min-h-[44px] min-w-[44px] rounded-full border border-[#313833] bg-[#171B19] text-[#B8C0BA] hover:text-[#F4F3ED] hover:border-[#55D6E8]/40 hover:bg-[#1f2422] active:scale-95 transition-all duration-200 flex items-center justify-center disabled:opacity-40 disabled:cursor-not-allowed shadow-md cursor-pointer"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Carousel Viewport & Track with Edge Fade Shadows -->
    <div class="relative -mx-4 sm:mx-0">
      <div
        id="carousel-left-shadow"
        class="pointer-events-none absolute left-0 top-0 bottom-4 w-12 bg-gradient-to-r from-[#080A09] to-transparent z-10 opacity-0 transition-opacity duration-300"
      >
      </div>
      <div
        id="carousel-right-shadow"
        class="pointer-events-none absolute right-0 top-0 bottom-4 w-12 bg-gradient-to-l from-[#080A09] to-transparent z-10 opacity-100 transition-opacity duration-300"
      >
      </div>

      <div
        id="flavor-carousel"
        class="flex gap-5 sm:gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth px-4 sm:px-0 py-4 scrollbar-none focus:outline-none"
        tabindex="0"
        aria-label="Carrusel de pulpas de fruta ArteFruta"
      >
        {
          flavors.map((flavor, index) => (
            <article
              data-category={flavor.category}
              data-index={index + 1}
              class={`flavor-card group snap-start flex-none w-[78vw] sm:w-[280px] md:w-[300px] lg:w-[320px] rounded-2xl border border-[#313833] bg-[#171B19] hover:border-[#36C98F]/40 hover:bg-[#1c221f] transition-colors duration-300 flex flex-col justify-between overflow-hidden p-4 sm:p-5 shadow-xl shadow-black/50 ${index === 0 ? "animate-scroll-nudge" : ""}`}
            >
              <div>
                <div class="relative w-full aspect-[4/3] rounded-xl overflow-hidden bg-[#080A09] mb-4 border border-[#313833]/80 flex items-center justify-center p-3 group-hover:border-[#36C98F]/30 transition-colors shadow-inner">
                  <Picture
                    src={flavor.image}
                    formats={["avif", "webp"]}
                    widths={[240, 320, 480]}
                    width={320}
                    height={240}
                    sizes="(max-width: 640px) 78vw, (max-width: 768px) 280px, 320px"
                    alt={`Pulpa de ${flavor.name} congelada al por mayor en Bucaramanga - ArteFruta`}
                    class="w-full h-full object-contain filter contrast-105 group-hover:scale-105 transition-transform duration-500 ease-out"
                    loading={index < 2 ? "eager" : "lazy"}
                    decoding={index < 2 ? "sync" : "async"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                  />

                  <span class="absolute top-2.5 right-2.5 px-2.5 py-1 rounded-full text-xs font-mono-data font-semibold bg-[#080A09]/90 text-[#55D6E8] border border-[#55D6E8]/40 backdrop-blur-md shadow-sm">
                    -18°C
                  </span>
                </div>

                <div class="mb-1.5">
                  <h3 class="text-xl sm:text-2xl font-bold font-heading text-[#F4F3ED] group-hover:text-[#36C98F] transition-colors tracking-tight text-wrap:balance">
                    {flavor.name}
                  </h3>
                </div>

                <p class="text-xs text-[#B8C0BA] font-mono-data mb-4">
                  250g | 500g | 1.000g
                </p>
              </div>

              <div class="flex items-center gap-2 pt-3 border-t border-[#313833]">
                <button
                  type="button"
                  class="open-modal-btn flex-1 min-h-[44px] py-2.5 px-3 rounded-full text-xs font-semibold text-[#B8C0BA] hover:text-[#55D6E8] bg-[#080A09] hover:bg-[#171B19] border border-[#313833] hover:border-[#55D6E8]/40 active:scale-95 transition-all duration-200 text-center shadow-sm flex items-center justify-center gap-1.5 focus:outline-none focus:ring-2 focus:ring-[#55D6E8]/40 cursor-pointer"
                  data-flavor-id={flavor.id}
                  aria-label={`Ver ficha técnica y solicitar muestra de pulpa de ${flavor.name}`}
                >
                  <span>Ficha y muestra</span>
                  <span aria-hidden="true">🧪</span>
                </button>

                <a
                  href={`https://wa.me/573177963888?text=Hola%20ArteFruta,%20deseo%20cotizar%20la%20pulpa%20de%20${encodeURIComponent(flavor.name)}%20para%20mi%20negocio`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="min-h-[44px] py-2.5 px-4 rounded-full text-xs font-semibold text-[#080A09] bg-[#36C98F] hover:bg-[#2EB37E] active:scale-95 transition-all duration-200 inline-flex items-center justify-center gap-1.5 shadow-md shadow-[#36C98F]/20 border border-[#36C98F] shrink-0 focus:outline-none focus:ring-2 focus:ring-[#36C98F]/40 cursor-pointer"
                  aria-label={`Cotizar pulpa de ${flavor.name} por WhatsApp`}
                >
                  <svg
                    class="w-3.5 h-3.5 text-[#080A09] fill-current"
                    viewBox="0 0 24 24"
                  >
                    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
                  </svg>
                  <span>Cotizar</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <!-- Carousel Progress Bar -->
      <div
        class="mt-6 hidden sm:block w-full max-w-md mx-auto bg-[#171B19] border border-[#313833] rounded-full h-1.5 overflow-hidden"
      >
        <div
          id="carousel-progress"
          class="bg-[#36C98F] h-full w-[10%] rounded-full transition-all duration-300"
        >
        </div>
      </div>
    </div>
  </div>

  <!-- Technical Modal for Detailed Flavor Inspection -->
  <div
    id="tech-modal"
    class="fixed inset-0 z-50 hidden bg-[#080A09]/85 backdrop-blur-md flex items-center justify-center p-3 sm:p-4 transition-all duration-300"
    aria-hidden="true"
    role="dialog"
    aria-labelledby="modal-title"
  >
    <div
      class="relative w-full max-w-xl rounded-2xl border border-[#313833] bg-[#171B19] shadow-2xl max-h-[85vh] overflow-y-auto overscroll-contain flex flex-col p-5 sm:p-7 focus:outline-none scrollbar-thin"
    >
      <div
        class="sticky top-0 z-20 flex justify-end pointer-events-none -mt-2 -mr-2 mb-2"
      >
        <button
          id="close-modal-btn"
          type="button"
          class="pointer-events-auto bg-[#080A09]/90 hover:bg-[#313833] border border-[#313833] text-[#B8C0BA] hover:text-[#F4F3ED] w-11 h-11 min-h-[44px] min-w-[44px] p-2.5 rounded-full backdrop-blur-md transition-all duration-200 active:scale-95 shadow-lg focus:outline-none focus:ring-2 focus:ring-[#55D6E8]/40 cursor-pointer flex items-center justify-center"
          aria-label="Cerrar ficha técnica"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div id="modal-content" class="flex-1"></div>
    </div>
  </div>
</section>

<style>
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  @keyframes swayX {
    0%,
    100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(5px);
    }
  }
  .animate-sway-x {
    animation: swayX 1.4s cubic-bezier(0.32, 0.72, 0, 1) infinite;
  }

  /* Animación de aviso (Scroll Nudge) optimizada por hardware (GPU) */
  @keyframes scrollNudge {
    0% {
      transform: translateX(0);
    }
    30% {
      transform: translateX(18px);
    }
    60% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(0);
    }
  }

  .animate-scroll-nudge {
    animation: scrollNudge 1.4s cubic-bezier(0.25, 1, 0.5, 1) 0.8s both;
    will-change: transform;
    backface-visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-scroll-nudge {
      animation: none !important;
      transform: none !important;
    }
  }

  .scrollbar-thin {
    scrollbar-width: thin;
    scrollbar-color: #3f3f46 transparent;
  }
  .scrollbar-thin::-webkit-scrollbar {
    width: 6px;
  }
  .scrollbar-thin::-webkit-scrollbar-track {
    background: transparent;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb {
    background: #3f3f46;
    border-radius: 9999px;
  }
</style>

<script define:vars={{ flavorsData: flavors }}>
  document.addEventListener("DOMContentLoaded", () => {
    const carousel = document.getElementById("flavor-carousel");
    const prevBtn = document.getElementById("carousel-prev-btn");
    const nextBtn = document.getElementById("carousel-next-btn");
    const counter = document.getElementById("carousel-counter");
    const progressBar = document.getElementById("carousel-progress");
    const filterBtns = document.querySelectorAll(".catalog-filter-btn");
    const cards = document.querySelectorAll(".flavor-card");
    const leftShadow = document.getElementById("carousel-left-shadow");
    const rightShadow = document.getElementById("carousel-right-shadow");
    const dragHint = document.getElementById("carousel-drag-hint");

    function getVisibleCards() {
      return Array.from(cards).filter(
        (card) => !card.classList.contains("hidden"),
      );
    }

    function updateCarouselState() {
      if (!carousel) return;
      const visibleCards = getVisibleCards();
      const total = visibleCards.length;
      if (total === 0) return;

      const scrollLeft = carousel.scrollLeft;
      const scrollWidth = carousel.scrollWidth - carousel.clientWidth;
      const cardWidth = visibleCards[0]?.offsetWidth || 300;

      const currentIndex = Math.min(
        total,
        Math.max(1, Math.round(scrollLeft / cardWidth) + 1),
      );

      if (counter) {
        counter.textContent = `${currentIndex} / ${total}`;
      }

      if (progressBar) {
        const progressPercent =
          scrollWidth > 0
            ? Math.min(100, Math.max(10, (scrollLeft / scrollWidth) * 100))
            : 100;
        progressBar.style.width = `${progressPercent}%`;
      }

      if (prevBtn) {
        prevBtn.disabled = scrollLeft <= 10;
      }
      if (nextBtn) {
        nextBtn.disabled = scrollLeft >= scrollWidth - 15;
      }

      if (leftShadow) {
        leftShadow.style.opacity = scrollLeft > 15 ? "1" : "0";
      }
      if (rightShadow) {
        rightShadow.style.opacity = scrollLeft >= scrollWidth - 15 ? "0" : "1";
      }

      if (dragHint) {
        dragHint.style.opacity = scrollLeft > 40 ? "0.4" : "1";
      }
    }

    function scrollCarousel(direction) {
      if (!carousel) return;
      const visibleCards = getVisibleCards();
      if (visibleCards.length === 0) return;

      const cardWidth = visibleCards[0].offsetWidth + 24;
      carousel.scrollBy({
        left: direction * cardWidth,
        behavior: "smooth",
      });
    }

    prevBtn?.addEventListener("click", () => scrollCarousel(-1));
    nextBtn?.addEventListener("click", () => scrollCarousel(1));
    carousel?.addEventListener("scroll", updateCarouselState, {
      passive: true,
    });

    const firstCard = carousel?.querySelector(".flavor-card");
    if (firstCard) {
      firstCard.addEventListener(
        "animationend",
        () => {
          firstCard.style.willChange = "auto";
        },
        { once: true },
      );
    }

    carousel?.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        scrollCarousel(-1);
      } else if (e.key === "ArrowRight") {
        scrollCarousel(1);
      }
    });

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.getAttribute("data-filter");

        filterBtns.forEach((b) => {
          b.classList.remove("bg-[#F4F3ED]", "text-[#080A09]", "shadow-sm");
          b.classList.add("text-[#B8C0BA]");
          b.setAttribute("aria-selected", "false");
        });
        btn.classList.add("bg-[#F4F3ED]", "text-[#080A09]", "shadow-sm");
        btn.classList.remove("text-[#B8C0BA]");
        btn.setAttribute("aria-selected", "true");

        cards.forEach((card) => {
          const cat = card.getAttribute("data-category");
          if (filter === "todas" || cat === filter) {
            card.classList.remove("hidden");
          } else {
            card.classList.add("hidden");
          }
        });

        if (carousel) {
          carousel.scrollTo({ left: 0, behavior: "smooth" });
        }

        setTimeout(updateCarouselState, 150);
      });
    });

    const modal = document.getElementById("tech-modal");
    const modalContent = document.getElementById("modal-content");
    const closeModalBtn = document.getElementById("close-modal-btn");
    const openModalBtns = document.querySelectorAll(".open-modal-btn");

    function openModal(id) {
      const item = flavorsData.find((f) => f.id === id);
      if (!item || !modalContent) return;

      modalContent.innerHTML = `
        <div class="mb-5 pr-6">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-[#080A09] text-[#55D6E8] border border-[#313833] mb-2.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#55D6E8]"></span>
            <span>${item.categoryLabel} · 100% Fruta Natural a -18°C</span>
          </div>
          <h3 id="modal-title" class="text-2xl sm:text-3xl font-bold font-heading text-[#F4F3ED] mb-2 tracking-tight">
            Pulpa de ${item.name} ${item.variety ? `<span class="text-[#B8C0BA] font-normal text-lg sm:text-xl">(${item.variety})</span>` : ""}
          </h3>
          <p class="text-sm text-[#B8C0BA] font-sans leading-relaxed">
            ${item.profile}
          </p>
        </div>

        <div class="grid grid-cols-2 gap-3 mb-5">
          <div class="rounded-xl bg-[#080A09] border border-[#313833] p-3 sm:p-3.5">
            <span class="text-xs uppercase tracking-wider text-[#B8C0BA] block mb-1">Grados Brix (°Bx)</span>
            <span class="font-mono-data text-xl font-bold text-[#F5B942]">${item.brix}</span>
            <span class="text-[11px] text-[#B8C0BA]/70 block mt-1">Control de dulzor estándar</span>
          </div>
          <div class="rounded-xl bg-[#080A09] border border-[#313833] p-3 sm:p-3.5">
            <span class="text-xs uppercase tracking-wider text-[#B8C0BA] block mb-1">Acidez (pH)</span>
            <span class="font-mono-data text-xl font-bold text-[#55D6E8]">${item.ph}</span>
            <span class="text-[11px] text-[#B8C0BA]/70 block mt-1">Estabilidad en barra y cocina</span>
          </div>
        </div>

        <div class="space-y-3 mb-6 text-sm">
          <div class="rounded-xl bg-[#080A09] border border-[#313833] p-3.5 sm:p-4">
            <strong class="text-[#F4F3ED] flex items-center gap-2 mb-1 font-semibold">
              <span class="text-base" aria-hidden="true">🍹</span>
              <span>Aplicaciones Recomendadas:</span>
            </strong>
            <p class="text-[#B8C0BA] leading-relaxed">${item.applications}</p>
          </div>

          <div class="rounded-xl bg-[#080A09] border border-[#313833] p-3.5 sm:p-4">
            <strong class="text-[#F4F3ED] flex items-center gap-2 mb-1 font-semibold">
              <span class="text-base" aria-hidden="true">⚡</span>
              <span>Rendimiento Operativo:</span>
            </strong>
            <p class="text-[#B8C0BA] leading-relaxed">${item.yield}</p>
          </div>

          <div class="rounded-xl bg-[#080A09] border border-[#313833] p-3.5 sm:p-4">
            <strong class="text-[#F4F3ED] flex items-center gap-2 mb-1 font-semibold">
              <span class="text-base" aria-hidden="true">📦</span>
              <span>Presentaciones Disponibles:</span>
            </strong>
            <p class="text-[#B8C0BA] leading-relaxed">
              Bolsas selladas de <strong class="text-[#F4F3ED]">250g</strong>, <strong class="text-[#F4F3ED]">500g</strong> y <strong class="text-[#F4F3ED]">1.000g</strong> (1 kg). Conservación continua al núcleo a -18°C.
            </p>
          </div>

          <div class="rounded-xl bg-[#080A09] border border-[#313833] p-3.5 sm:p-4">
            <strong class="text-[#F4F3ED] flex items-center gap-2 mb-1 font-semibold">
              <span class="text-base" aria-hidden="true">🏭</span>
              <span>Capacidad de Planta y Suministro:</span>
            </strong>
            <p class="text-[#B8C0BA] leading-relaxed">
              Línea continua de empaque a <strong class="text-[#F5B942]">30 pulpas/minuto</strong>. Suministro garantizado desde <strong class="text-[#F4F3ED]">1 unidad hasta toneladas</strong> para canal HORECA, cafeterías, casinos y grandes superficies con entregas programadas.
            </p>
          </div>

          <div class="rounded-xl bg-[#080A09] border border-[#55D6E8]/30 p-3.5 sm:p-4 bg-gradient-to-r from-[#080A09] to-[#55D6E8]/5">
            <strong class="text-[#55D6E8] flex items-center gap-2 mb-1.5 font-semibold text-xs sm:text-sm uppercase tracking-wider">
              <span class="text-base" aria-hidden="true">🧪</span>
              <span>Muestras Técnicas para Cocina y Barra:</span>
            </strong>
            <p class="text-[#B8C0BA] text-xs sm:text-sm leading-relaxed">
              Si lideras cocina, barra de coctelería o cafetería de especialidad, solicita una muestra refrigerada para verificar grados Brix, consistencia y acidez en tus propias recetas.
            </p>
          </div>
        </div>
      `;

      modal?.classList.remove("hidden");
      modal?.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      modal?.classList.add("hidden");
      modal?.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    openModalBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-flavor-id");
        openModal(id);
      });
    });

    closeModalBtn?.addEventListener("click", closeModal);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeModal();
    });
  });
</script>
</file>

<file path="src/components/Navbar.astro">
---
import { Picture } from "astro:assets";
import logoWebp from "../assets/images/logo-artefruta.webp";
---

<header class="fixed top-0 left-0 right-0 z-50 px-4 sm:px-6">

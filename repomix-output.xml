      >
      <a href="#faq" class="hover:text-[#F4F3ED] transition-colors"
        >Preguntas Frecuentes</a
      >
    </div>

    <!-- Desktop CTA Button: Verde Esmeralda #36C98F -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="https://wa.me/573177963888?text=Hola%20ArteFruta,%20deseo%20cotizar%20pulpas%20de%20fruta%20congeladas%20para%20mi%20negocio"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center min-h-[44px] gap-2 text-sm font-semibold text-[#080A09] bg-[#36C98F] hover:bg-[#2EB37E] active:scale-[0.98] py-2.5 px-4 rounded-full transition-all duration-200 shadow-md shadow-[#36C98F]/20 font-sans cursor-pointer"
      >
        <span>Cotizar Pedido</span>
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="sm:hidden relative w-11 h-11 min-h-[44px] min-w-[44px] flex items-center justify-center rounded-full text-[#B8C0BA] hover:text-[#F4F3ED] focus:outline-none focus:ring-2 focus:ring-[#36C98F]/30 cursor-pointer"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <div class="w-5 h-4 flex flex-col justify-between">
        <span
          id="line-top"
          class="w-full h-0.5 bg-[#F4F3ED] rounded-full transition-all duration-300 transform origin-left"
        ></span>
        <span
          id="line-mid"
          class="w-full h-0.5 bg-[#F4F3ED] rounded-full transition-all duration-300"
        ></span>
        <span
          id="line-bot"
          class="w-full h-0.5 bg-[#F4F3ED] rounded-full transition-all duration-300 transform origin-left"
        ></span>
      </div>
    </button>
  </nav>

  <!-- Mobile Overlay Menu (Fluid island expanded state) -->
  <div
    id="mobile-menu"
    class="sm:hidden hidden fixed inset-x-4 top-20 rounded-2xl border border-[#313833] bg-[#171B19]/98 backdrop-blur-2xl p-6 shadow-2xl shadow-black z-40 transition-all duration-300"
  >
    <div class="flex flex-col gap-3 text-base font-medium font-sans">
      <a
        href="#sabores"
        class="mobile-nav-link text-[#B8C0BA] hover:text-[#F4F3ED] min-h-[44px] flex items-center py-2.5 border-b border-[#313833]/60"
        >Catálogo de Sabores</a
      >
      <a
        href="#planta"
        class="mobile-nav-link text-[#B8C0BA] hover:text-[#F4F3ED] min-h-[44px] flex items-center py-2.5 border-b border-[#313833]/60"
        >Sede y Planta</a
      >
      <a
        href="#faq"
        class="mobile-nav-link text-[#B8C0BA] hover:text-[#F4F3ED] min-h-[44px] flex items-center py-2.5 border-b border-[#313833]/60"
        >Preguntas Frecuentes</a
      >

      <a
        href="https://wa.me/573177963888?text=Hola%20ArteFruta,%20deseo%20cotizar%20pulpas%20de%20fruta%20congeladas%20para%20mi%20negocio"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 w-full min-h-[48px] flex items-center justify-center gap-2 text-base font-semibold text-[#080A09] bg-[#36C98F] hover:bg-[#2EB37E] py-3.5 rounded-full transition-colors cursor-pointer"
      >
        <span>Cotizar Pedido</span>
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const lineTop = document.getElementById("line-top");
  const lineMid = document.getElementById("line-mid");
  const lineBot = document.getElementById("line-bot");
  const links = document.querySelectorAll(".mobile-nav-link");

  let isOpen = false;

  btn?.addEventListener("click", () => {
    isOpen = !isOpen;
    btn.setAttribute("aria-expanded", String(isOpen));
    if (isOpen) {
      menu?.classList.remove("hidden");
      lineTop?.classList.add("rotate-45", "translate-y-1.5");
      lineMid?.classList.add("opacity-0");
      lineBot?.classList.add("-rotate-45", "-translate-y-1.5");
    } else {
      menu?.classList.add("hidden");
      lineTop?.classList.remove("rotate-45", "translate-y-1.5");
      lineMid?.classList.remove("opacity-0");
      lineBot?.classList.remove("-rotate-45", "-translate-y-1.5");
    }
  });

  links.forEach((l) => {
    l.addEventListener("click", () => {
      isOpen = false;
      menu?.classList.add("hidden");
      lineTop?.classList.remove("rotate-45", "translate-y-1.5");
      lineMid?.classList.remove("opacity-0");
      lineBot?.classList.remove("-rotate-45", "-translate-y-1.5");
    });
  });
</script>

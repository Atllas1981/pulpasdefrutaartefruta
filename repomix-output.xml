  >
    <!-- Logo with Circular Badge & Brand Wordmark -->
    <a
      href="#hero"
      class="flex items-center gap-2.5 sm:gap-3.5 group cursor-pointer"
      aria-label="Ir al inicio de ArteFruta"
      onclick="window.scrollTo({ top: 0, behavior: 'smooth' });"
    >
      <div
        class="h-12 w-12 sm:h-14 sm:w-14 rounded-full bg-white border border-white/40 shadow-lg shadow-black/50 flex items-center justify-center p-1 transition-all duration-300 group-hover:scale-105 active:scale-95 shrink-0 overflow-hidden"

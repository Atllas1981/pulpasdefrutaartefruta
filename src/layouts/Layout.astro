---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ArteFruta | Pulpa de Fruta 100% Natural en Bucaramanga",
  description = "Proveedor de pulpas de fruta congeladas a -18°C para gastronomía, repostería y sector Horeca en Bucaramanga y Santander."
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// URL base canónica — Astro.site = 'https://atllas1981.github.io'
const siteOrigin = Astro.site ?? new URL('https://atllas1981.github.io');
const canonicalURL = new URL(
  Astro.url.pathname,
  siteOrigin
).href;

// OG image — URL absoluta completa incluyendo base path del repositorio
const ogImageUrl = new URL(
  `pulpasdefrutaartefruta/images/og-artefruta.jpg`,
  siteOrigin
).href;

const ogAlt = "ArteFruta — Pulpas de fruta 100% naturales para gastronomía y coctelería en Colombia";
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" href={`${base}/favicon.ico`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />

    <!-- SEO primario -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#181818" />

    <!-- Open Graph (Facebook · WhatsApp · LinkedIn) -->
    <meta property="og:site_name" content="ArteFruta" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={ogAlt} />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <!-- Schema.org JSON-LD Local SEO WholesaleStore -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WholesaleStore",
      "@id": "https://atllas1981.github.io/pulpasdefrutaartefruta/#wholesalestore",
      "name": "Pulpas de Fruta ArteFruta",
      "description": "Proveedor mayorista de pulpas de fruta 100% naturales congeladas a -18°C para restaurantes, cafeterías, hoteles, reposterías y barras de coctelería.",
      "image": ogImageUrl,
      "url": "https://atllas1981.github.io/pulpasdefrutaartefruta/",
      "telephone": "+573177963888",
      "priceRange": "$$",
      "currenciesAccepted": "COP",
      "paymentAccepted": "Cash, Credit Card, Bank Transfer, Nequi, Daviplata",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Centroabastos, Bodega 9 Local 111 (Punto de Venta) y Bodega 13 Local 3B (Planta de Producción)",
        "addressLocality": "Bucaramanga",
        "addressRegion": "Santander",
        "postalCode": "680005",
        "addressCountry": "CO"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 7.0872,
        "longitude": -73.1614
      },
      "areaServed": [
        {
          "@type": "AdministrativeArea",
          "name": "Área Metropolitana de Bucaramanga",
          "containsPlace": [
            { "@type": "City", "name": "Bucaramanga" },
            { "@type": "City", "name": "Floridablanca" },
            { "@type": "City", "name": "Girón" },
            { "@type": "City", "name": "Piedecuesta" }
          ]
        },
        {
          "@type": "AdministrativeArea",
          "name": "Cobertura Santander e Interdepartamental",
          "containsPlace": [
            { "@type": "City", "name": "Cúcuta" },
            { "@type": "City", "name": "Barrancabermeja" },
            { "@type": "City", "name": "San Gil" },
            { "@type": "City", "name": "Valledupar" },
            { "@type": "City", "name": "Santa Marta" },
            { "@type": "City", "name": "Cartagena" },
            { "@type": "City", "name": "Barranquilla" }
          ]
        }
      ]
    })} />

    <!-- Google Fonts: Manrope (Headings) & Inter (Interface) — Preconnect & Non-blocking Preload -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap"
      />
    </noscript>
  </head>
  <body class="bg-[#080A09] text-[#F4F3ED] antialiased selection:bg-[#36C98F]/25 selection:text-[#36C98F] min-h-screen font-sans">
    <slot />

    <!-- Smooth scroll (Lenis) and Scroll animations -->
    <script>
      // ─── Deferred initialization ───────────────────────────────────────────
      // Lenis (~14 KB) + GSAP (~30 KB) are loaded via dynamic import() and
      // scheduled with requestIdleCallback so they never compete with FCP/LCP.
      // ───────────────────────────────────────────────────────────────────────

      async function initSmoothScroll() {
        const [{ default: Lenis }, { default: gsap }, { ScrollTrigger }] =
          await Promise.all([
            import('lenis'),
            import('gsap'),
            import('gsap/ScrollTrigger'),
          ]);

        gsap.registerPlugin(ScrollTrigger);

        // Initialize Lenis
        const lenis = new Lenis({
          duration: 1.1,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          smoothWheel: true,
        });

        // Connect Lenis to ScrollTrigger
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time: number) => {
          lenis.raf(time * 1000);
        });
        gsap.ticker.lagSmoothing(0);

        // Single rAF loop — avoid duplicate loops
        function raf(time: number) {
          lenis.raf(time);
          ScrollTrigger.update();
        }
        gsap.ticker.add(raf);
      }

      function initScrollReveal() {
        // IntersectionObserver for scroll-reveal — always lightweight, init early
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.scroll-reveal').forEach((el) => {
          observer.observe(el);
        });
      }

      // IntersectionObserver is cheap — init immediately after DOM ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollReveal);
      } else {
        initScrollReveal();
      }

      // Lenis + GSAP are heavy — defer until browser is idle
      // Safari fallback: requestIdleCallback not supported, use setTimeout
      if ('requestIdleCallback' in window) {
        requestIdleCallback(initSmoothScroll, { timeout: 2500 });
      } else {
        // On Safari, wait until after first paint
        window.addEventListener('load', () => setTimeout(initSmoothScroll, 300), { once: true });
      }
    </script>
  </body>
</html>

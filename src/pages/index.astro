---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import TaglineReveal from '../components/TaglineReveal.astro';
import FlavorCatalog from '../components/FlavorCatalog.astro';
import PhysicalPlant from '../components/PhysicalPlant.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
---

<Layout 
  title="ArteFruta | Pulpa de Fruta Natural en Bucaramanga"
  description="Descubre ArteFruta: pulpas de fruta de calidad al por mayor en Bucaramanga. Variedad, sabor y calidad para tu negocio."
>
  <Navbar />
  
  <main class="pb-28">
    <Hero />
    <FlavorCatalog />
    <TaglineReveal />
    <PhysicalPlant />
    <FAQ />
    <FinalCTA />
  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>

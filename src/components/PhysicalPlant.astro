---
---

<section id="planta" class="py-24 sm:py-32 px-4 sm:px-6 bg-[#181818] border-t border-neutral-800">
  <div class="max-w-6xl mx-auto scroll-reveal">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-emerald-400 mb-3">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span>Distribución Operativa en Bucaramanga</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white mb-4 text-wrap:balance">
        Dos sedes operativas en Centroabastos para respaldar tu negocio
      </h2>
      <p class="text-neutral-400 text-base sm:text-lg leading-relaxed text-wrap:pretty">
        Separamos la producción industrial de la atención comercial para ofrecer máxima capacidad de suministro continuo junto con rapidez total en entregas locales y pedidos por volumen.
      </p>
    </div>

    <!-- Dual Cards: Punto de Venta vs Planta de Producción -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
      
      <!-- Card 1: Punto de Venta y Atención Comercial -->
      <div class="rounded-2xl border border-neutral-800 bg-black p-6 sm:p-8 flex flex-col justify-between hover:border-neutral-700 transition-all duration-300">
        <div>
          <!-- Header Badge & Status -->
          <div class="flex items-center justify-between gap-4 mb-6">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              Punto de Venta y Despachos
            </span>
            <span class="text-xs text-neutral-400 font-mono-data">Atención comercial</span>
          </div>

          <!-- Location Name -->
          <h3 class="text-2xl font-bold text-white mb-1">
            Bodega 9, Local 111
          </h3>
          <p class="text-emerald-400 text-sm font-medium mb-6">
            Centroabastos · Bucaramanga, Santander
          </p>

          <!-- Description -->
          <p class="text-neutral-300 text-sm leading-relaxed mb-6 text-wrap:pretty">
            Espacio diseñado para atención presencial rápida, degustaciones de producto para chefs o baristas y recogida inmediata de pedidos sin requerir monto mínimo.
          </p>

          <!-- Specifications List -->
          <ul class="space-y-3.5 mb-8 text-sm">
            <li class="flex items-start gap-3">
              <span class="p-1 rounded-md bg-neutral-900 border border-neutral-800 text-emerald-400 shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <div>
                <strong class="text-white block text-sm font-semibold">Venta desde una unidad:</strong>
                <span class="text-neutral-400 text-xs leading-relaxed">Disponibilidad en vitrina en presentaciones de 250g, 500g y 1.000g al detal o por mayor.</span>
              </div>
            </li>

            <li class="flex items-start gap-3">
              <span class="p-1 rounded-md bg-neutral-900 border border-neutral-800 text-emerald-400 shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <div>
                <strong class="text-white block text-sm font-semibold">Recogida exprés de pedidos:</strong>
                <span class="text-neutral-400 text-xs leading-relaxed">Programa tu orden por WhatsApp y retira en minutos con empaque isotérmico listo para transporte.</span>
              </div>
            </li>

            <li class="flex items-start gap-3">
              <span class="p-1 rounded-md bg-neutral-900 border border-neutral-800 text-emerald-400 shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <div>
                <strong class="text-white block text-sm font-semibold">Horario madrugador para hostelería:</strong>
                <span class="text-neutral-400 text-xs leading-relaxed">Lunes a sábado desde las 5:00 AM para abastecer tu cocina antes de iniciar la jornada.</span>
              </div>
            </li>
          </ul>
        </div>

        <!-- Action Link -->
        <a 
          href="https://wa.me/573177963888?text=Hola%20ArteFruta,%20deseo%20coordinar%20una%20recogida%20en%20el%20Punto%20de%20Venta%20(Bodega%209%20Local%20111)" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2 text-sm font-semibold text-black bg-white hover:bg-neutral-200 py-3 px-4 rounded-xl transition-all duration-200"
        >
          <span>Coordinar recogida en Bodega 9</span>
          <svg class="w-4 h-4 text-emerald-600 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
        </a>
      </div>

      <!-- Card 2: Planta de Producción y Procesamiento -->
      <div class="rounded-2xl border border-neutral-800 bg-black p-6 sm:p-8 flex flex-col justify-between hover:border-neutral-700 transition-all duration-300">
        <div>
          <!-- Header Badge & Status -->
          <div class="flex items-center justify-between gap-4 mb-6">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
              <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
              Planta de Producción
            </span>
            <span class="text-xs text-neutral-400 font-mono-data">Capacidad industrial</span>
          </div>

          <!-- Location Name -->
          <h3 class="text-2xl font-bold text-white mb-1">
            Bodega 13, Local 3B
          </h3>
          <p class="text-cyan-400 text-sm font-medium mb-6">
            Centroabastos · Bucaramanga, Santander
          </p>

          <!-- Description -->
          <p class="text-neutral-300 text-sm leading-relaxed mb-6 text-wrap:pretty">
            Línea industrial de despulpe, sellado continuo y ultracongelación técnica para grandes volúmenes destinados a restaurantes, hoteles y distribuidores regionales.
          </p>

          <!-- Technical Metrics Grid -->
          <div class="grid grid-cols-2 gap-3 mb-6">
            <div class="p-3.5 rounded-xl bg-[#181818] border border-neutral-800">
              <span class="text-xs text-neutral-400 block mb-1">Envasado continuo</span>
              <strong class="text-base sm:text-lg font-bold text-white font-mono-data">30 pulpas / min</strong>
            </div>
            <div class="p-3.5 rounded-xl bg-[#181818] border border-neutral-800">
              <span class="text-xs text-neutral-400 block mb-1">Frío al núcleo</span>
              <strong class="text-base sm:text-lg font-bold text-cyan-400 font-mono-data">-18°C estable</strong>
            </div>
          </div>

          <!-- Specifications List -->
          <ul class="space-y-3.5 mb-8 text-sm">
            <li class="flex items-start gap-3">
              <span class="p-1 rounded-md bg-neutral-900 border border-neutral-800 text-cyan-400 shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <div>
                <strong class="text-white block text-sm font-semibold">Cero dilución en agua:</strong>
                <span class="text-neutral-400 text-xs leading-relaxed">Formulación 100% pulpa de fruta sin aditivos ni conservantes añadidos.</span>
              </div>
            </li>

            <li class="flex items-start gap-3">
              <span class="p-1 rounded-md bg-neutral-900 border border-neutral-800 text-cyan-400 shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <div>
                <strong class="text-white block text-sm font-semibold">Cámaras con monitoreo y planta de respaldo:</strong>
                <span class="text-neutral-400 text-xs leading-relaxed">Continuidad térmica 24/7 que protege el inventario ante cualquier contingencia eléctrica.</span>
              </div>
            </li>
          </ul>
        </div>

        <!-- Action Link -->
        <a 
          href="https://wa.me/573177963888?text=Hola%20ArteFruta,%20deseo%20cotizar%20suministro%20industrial%20por%20volumen%20desde%20la%20Planta" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2 text-sm font-semibold text-white bg-neutral-900 hover:bg-neutral-800 border border-neutral-700 py-3 px-4 rounded-xl transition-all duration-200"
        >
          <span>Cotizar volumen de Planta</span>
          <svg class="w-4 h-4 text-cyan-400 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
        </a>
      </div>

    </div>

    <!-- Logistics Connection Bar -->
    <div class="rounded-2xl border border-neutral-800 bg-black p-5 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-neutral-900 border border-neutral-800 flex items-center justify-center text-emerald-400 shrink-0">
          📍
        </div>
        <div>
          <span class="text-xs uppercase tracking-wider text-neutral-400 block font-semibold">Ubicación estratégica</span>
          <p class="text-sm text-neutral-300 font-medium">Centroabastos Bucaramanga · Km 4 Vía a Girón</p>
        </div>
      </div>
      <div class="text-xs text-neutral-400 text-center sm:text-right">
        <span>Conexión directa con transportadoras para Santander y la Costa Caribe</span>
      </div>
    </div>

  </div>
</section>

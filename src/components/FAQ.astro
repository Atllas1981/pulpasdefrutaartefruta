---
interface FaqItem {
  question: string;
  intro: string;
  bullets: string[];
}

const faqs: FaqItem[] = [
  {
    question: "¿Cuál es el pedido mínimo para despachos o compras en el punto físico?",
    intro: "Flexibilidad total de compra según las necesidades de tu establecimiento:",
    bullets: [
      "<strong class='text-[#F4F3ED] font-semibold'>Venta física sin mínimo:</strong> Puedes llevar desde <strong>1 sola pulpa</strong> (250g, 500g o 1.000g) en nuestro punto comercial en <strong>Centroabastos (Bodega 9, Local 111, Bucaramanga)</strong>.",
      "<strong class='text-[#F4F3ED] font-semibold'>Despachos en el Área Metropolitana:</strong> Entregas programadas a domicilio para restaurantes, cafeterías y barras coordinadas por <strong>WhatsApp (+57 317 7963888)</strong>.",
      "<strong class='text-[#F4F3ED] font-semibold'>Suministro por volumen:</strong> Precios preferenciales y escalas de descuento para compras periódicas en hoteles, casinos y reposterías."
    ]
  },
  {
    question: "¿Qué cobertura de envíos tienen y quién asume el costo del flete?",
    intro: "Cobertura metropolitana e interdepartamental cuidando estrictamente la cadena de frío:",
    bullets: [
      "<strong class='text-[#F4F3ED] font-semibold'>Retiro en punto físico ($0 flete):</strong> Recoge directamente en nuestro punto de venta en <strong>Centroabastos (Bodega 9, Local 111)</strong> sin costo de transporte.",
      "<strong class='text-[#F4F3ED] font-semibold'>Área Metropolitana de Bucaramanga:</strong> Entregas locales programadas en <strong>Bucaramanga, Floridablanca, Girón y Piedecuesta</strong>.",
      "<strong class='text-[#F4F3ED] font-semibold'>Despachos interdepartamentales:</strong> Envíos refrigerados hacia <strong>Norte de Santander, Cesar, Magdalena, Bolívar y Atlántico</strong>.",
      "<strong class='text-[#F4F3ED] font-semibold'>Modalidad de flete:</strong> Asumido por el cliente bajo modalidad de flete al cobro / contraentrega mediante transportadoras aliadas en frío."
    ]
  },
  {
    question: "¿Cuáles son las opciones de empaque y sus costos para proteger el producto?",
    intro: "Tres alternativas térmicas pensadas para cada distancia y horario de traslado:",
    bullets: [
      "<strong class='text-[#F4F3ED] font-semibold'>Caja de cartón ($0 COP):</strong> Sin costo adicional. Recomendada para despachos locales o viajes en madrugada con recepción y refrigeración inmediata.",
      "<strong class='text-[#F4F3ED] font-semibold'>Cava de icopor 8/10 ($50.000 COP):</strong> Opción económica y reutilizable con aislamiento térmico de hasta <strong>24 horas</strong>, ideal para media distancia.",
      "<strong class='text-[#F4F3ED] font-semibold'>Cava de icopor nueva 10/10 ($90.000 COP):</strong> Estructura virgen de grado industrial con sellado hermético superior para rutas hacia la <strong>Costa Caribe y climas cálidos</strong>."
    ]
  },
  {
    question: "¿Cómo funciona la ultracongelación a -18°C al núcleo y qué ventajas ofrece en rendimiento?",
    intro: "Choque térmico continuo que congela la pulpa pura hasta el núcleo:",
    bullets: [
      "<strong class='text-[#F4F3ED] font-semibold'>Conservación al núcleo a -18°C:</strong> Previene la formación de macrocristales de hielo, reteniendo aroma fresco, color vivo, acidez natural y vitaminas.",
      "<strong class='text-[#F4F3ED] font-semibold'>100% fruta pura sin agua:</strong> Sin dilución, sin conservantes químicos ni jarabes añadidos.",
      "<strong class='text-[#F4F3ED] font-semibold'>Eliminas el 40% o más de merma:</strong> Cero pérdidas por cáscaras o semillas, ahorras tiempo de pelado y estandarizas tus recetas los <strong>365 días del año</strong>."
    ]
  },
  {
    question: "¿En qué presentaciones y tamaños están disponibles las pulpas?",
    intro: "Formatos herméticos sellados adaptados a la operación diaria de tu barra o cocina:",
    bullets: [
      "<strong class='text-[#F4F3ED] font-semibold'>Bolsas de 250g y 500g:</strong> Porciones ideales para coctelería de autor, batidos frappé, pastelería fina y cafeterías.",
      "<strong class='text-[#F4F3ED] font-semibold'>Bolsas de 1.000g (1 kg):</strong> Presentación de alto rendimiento para licuadoras industriales, buffets y cocinas de producción.",
      "<strong class='text-[#F4F3ED] font-semibold'>Conservación lista:</strong> Empaque hermético que preserva el sabor y textura directamente en tu congelador a <strong>-18°C</strong>."
    ]
  },
  {
    question: "¿Por qué los precios fluctúan y se cotizan directamente por WhatsApp?",
    intro: "Precios transparentes vinculados a la cosecha directa del campo colombiano:",
    bullets: [
      "<strong class='text-[#F4F3ED] font-semibold'>Fruta 100% natural de temporada:</strong> Los costos responden a los ciclos de cosecha y oferta agrícola nacional.",
      "<strong class='text-[#F4F3ED] font-semibold'>Cotización en tiempo real:</strong> Escríbenos por <strong>WhatsApp (+57 317 7963888)</strong> para enviarte la lista oficial de precios del día.",
      "<strong class='text-[#F4F3ED] font-semibold'>Descuentos por escala:</strong> Tarifas comerciales especiales para compras continuas en restaurantes y barras."
    ]
  },
  {
    question: "¿Ofrecen muestras para pruebas de rendimiento en cocina, repostería o barra?",
    intro: "Pruebas técnicas operativas sin costo ni compromiso para profesionales gastronómicos:",
    bullets: [
      "<strong class='text-[#F4F3ED] font-semibold'>Evaluación técnica:</strong> Diseñada para que chefs, baristas y jefes de barra verifiquen grados Brix, acidez (pH) y textura en sus recetas.",
      "<strong class='text-[#F4F3ED] font-semibold'>Solicitud rápida:</strong> Escríbenos por <strong>WhatsApp</strong> indicando qué sabores deseas probar en tu establecimiento.",
      "<strong class='text-[#F4F3ED] font-semibold'>Catación presencial:</strong> Visítanos en nuestro punto comercial en <strong>Centroabastos (Bodega 9, Local 111)</strong> para evaluar el catálogo de temporada."
    ]
  },
  {
    question: "¿Cuál es la vida útil de las pulpas y cómo deben conservarse?",
    intro: "Guía rápida de almacenamiento y cadena de frío:",
    bullets: [
      "<strong class='text-[#F4F3ED] font-semibold'>Hasta 12 meses de vida útil:</strong> Manteniendo las pulpas ininterrumpidamente a <strong>-18°C en congelador</strong>.",
      "<strong class='text-[#F4F3ED] font-semibold'>Sin preservantes añadidos:</strong> La conservación se logra exclusivamente mediante choque térmico.",
      "<strong class='text-[#F4F3ED] font-semibold'>Consumo una vez descongelada:</strong> Conservar en refrigeración (2°C a 6°C) y consumir dentro de las siguientes <strong>48 horas</strong>."
    ]
  }
];
---

<section id="faq" class="py-24 sm:py-32 px-4 sm:px-6 bg-[#080A09] border-t border-[#313833]">
  <div class="max-w-4xl mx-auto">
    
    <div class="text-center mb-16 scroll-reveal">
      <div class="text-xs font-semibold uppercase tracking-wider text-[#36C98F] mb-3">
        Respuestas Claras para tu Negocio
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold font-heading tracking-tight text-[#F4F3ED] mb-4 text-wrap:balance">
        Preguntas frecuentes sobre pedidos, envíos y rendimiento
      </h2>
      <p class="text-base sm:text-lg text-[#B8C0BA] font-sans max-w-xl mx-auto text-wrap:pretty">
        Todo lo que necesitas saber sobre nuestras pulpas ultracongeladas a -18°C, tiempos de entrega y protocolos de despacho.
      </p>
    </div>

    <div class="space-y-4">
      {faqs.map((faq) => (
        <details 
          class="group rounded-2xl border border-[#313833] bg-[#171B19] p-5 sm:p-6 transition-all duration-300 open:border-[#36C98F]/40 open:bg-[#1c221f] scroll-reveal"
        >
          <summary class="flex cursor-pointer items-center justify-between text-base sm:text-lg font-semibold font-heading text-[#F4F3ED] list-none select-none min-h-[44px] py-3 focus:outline-none focus:ring-2 focus:ring-[#36C98F]/30 rounded-lg">
            <span class="pr-4">{faq.question}</span>
            <span class="ml-2 flex-shrink-0 text-[#36C98F] transition-transform duration-300 group-open:rotate-180">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-[#313833] text-sm sm:text-base text-[#B8C0BA] font-sans leading-relaxed">
            <p class="mb-3 text-xs sm:text-sm font-medium text-[#F4F3ED]/90">{faq.intro}</p>
            <ul class="space-y-2.5">
              {faq.bullets.map((bullet) => (
                <li class="text-xs sm:text-sm text-[#B8C0BA] leading-relaxed flex items-start gap-2.5">
                  <span class="text-[#36C98F] text-xs mt-1 shrink-0" aria-hidden="true">●</span>
                  <span set:html={bullet} />
                </li>
              ))}
            </ul>
          </div>
        </details>
      ))}
    </div>

  </div>
</section>
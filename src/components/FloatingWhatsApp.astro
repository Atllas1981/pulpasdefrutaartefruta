<style>
  :global(body.modal-open) #floating-whatsapp {
    display: none !important;
    opacity: 0 !important;
    pointer-events: none !important;
    visibility: hidden !important;
  }
</style>

<script>
  function setupFloatingVisibility() {
    const waButton = document.getElementById('floating-whatsapp');
    const techModal = document.getElementById('tech-modal');

    if (!waButton) return;

    function evaluateVisibility() {
      const isModalOpen = techModal && !techModal.classList.contains('hidden');
      if (isModalOpen || document.body.classList.contains('modal-open')) {
        waButton.classList.add('hidden', 'opacity-0', 'pointer-events-none');
        return;
      }

      // Priority 1: In the Hero section (top of the page), WhatsApp MUST be visible
      if (window.scrollY < 280) {
        waButton.classList.remove('hidden', 'opacity-0', 'pointer-events-none');
        return;
      }

      // Priority 2: Check if the carousel cards are currently in the view colliding with bottom-right
      const carousel = document.getElementById('flavor-carousel');
      if (carousel) {
        const rect = carousel.getBoundingClientRect();
        // Cards container intersects with the bottom portion of viewport
        const isColliding = rect.top < (window.innerHeight - 30) && rect.bottom > 70;
        if (isColliding) {
          waButton.classList.add('hidden', 'opacity-0', 'pointer-events-none');
          return;
        }
      }

      // Priority 3: Visible everywhere else (Planta, FAQ, Final CTA, Footer)
      waButton.classList.remove('hidden', 'opacity-0', 'pointer-events-none');
    }

    // Scroll & resize listeners
    window.addEventListener('scroll', evaluateVisibility, { passive: true });
    window.addEventListener('resize', evaluateVisibility, { passive: true });
    window.addEventListener('modal-state-change', evaluateVisibility);

    // MutationObserver to watch modal open/close
    if (techModal) {
      const modalObserver = new MutationObserver(() => evaluateVisibility());
      modalObserver.observe(techModal, { attributes: true, attributeFilter: ['class'] });
    }

    // Initial check (ensures button is immediately visible in Hero on load)
    evaluateVisibility();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFloatingVisibility);
  } else {
    setupFloatingVisibility();
  }
</script>

---
import { Picture } from "astro:assets";
import logoWebp from "../assets/images/logo-artefruta.webp";
---

<header class="fixed top-0 left-0 right-0 z-50 px-3.5 sm:px-6 pointer-events-none">
  <div class="mx-auto max-w-5xl pointer-events-auto relative">
    <nav
      class="mt-3 sm:mt-4 md:mt-5 mx-auto rounded-full border border-[#313833] bg-[#171B19]/92 backdrop-blur-xl px-3.5 sm:px-6 py-2 sm:py-2.5 flex items-center justify-between shadow-2xl shadow-black/60 transition-all duration-300 relative z-50"
    >
      <!-- Logo with Circular Badge & Brand Wordmark -->
      <a
        href="#hero"
        class="flex items-center gap-2 sm:gap-3.5 group cursor-pointer shrink-0"
        aria-label="Ir al inicio de ArteFruta"
        onclick="window.scrollTo({ top: 0, behavior: 'smooth' });"
      >
        <div
          class="h-10 w-10 sm:h-12 sm:w-12 md:h-13 md:w-13 rounded-full bg-white border border-white/40 shadow-lg shadow-black/50 flex items-center justify-center p-0.5 sm:p-1 transition-all duration-300 group-hover:scale-105 active:scale-95 shrink-0 overflow-hidden"
        >
          <Picture
            src={logoWebp}
            formats={["avif", "webp"]}
            widths={[144, 288]}
            width={144}
            height={144}
            alt="ArteFruta Pulpas 100% Natural"
            class="w-full h-full object-contain scale-[1.08]"
            loading="eager"
            fetchpriority="high"
            decoding="sync"
          />
        </div>
        <span
          class="font-heading font-extrabold text-lg sm:text-xl md:text-2xl text-[#F4F3ED] tracking-tight group-hover:text-[#36C98F] transition-colors select-none"
        >
          ArteFruta
        </span>
      </a>

      <!-- Desktop Nav Links (Visible at md: 768px+) -->
      <div
        class="hidden md:flex items-center gap-6 text-sm text-[#B8C0BA] font-medium font-sans"
      >
        <a href="#sabores" class="hover:text-[#F4F3ED] transition-colors py-1">Catálogo de Sabores</a>
        <a href="#planta" class="hover:text-[#F4F3ED] transition-colors py-1">Sede y Planta</a>
        <a href="#faq" class="hover:text-[#F4F3ED] transition-colors py-1">Preguntas Frecuentes</a>
      </div>

      <!-- Desktop CTA Button: Verde Esmeralda #36C98F (Visible at md: 768px+) -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href="tel:+573177963888"
          class="hidden lg:inline-flex items-center gap-1.5 text-xs text-[#B8C0BA] hover:text-[#36C98F] transition-colors font-medium py-2 px-3 rounded-full border border-[#313833] bg-[#080A09]"
        >
          <span>📞 317 7963888</span>
        </a>
        <a
          href="https://wa.me/573177963888?text=Hola%20ArteFruta,%20deseo%20cotizar%20pulpas%20de%20fruta%20congeladas%20para%20mi%20negocio"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center min-h-[42px] gap-2 text-sm font-semibold text-[#080A09] bg-[#36C98F] hover:bg-[#2EB37E] active:scale-[0.98] py-2 px-4 rounded-full transition-all duration-200 shadow-md shadow-[#36C98F]/20 font-sans cursor-pointer"
        >
          <span>Cotizar Pedido</span>
        </a>
      </div>

      <!-- Mobile Hamburger Button (Visible below md: 768px) -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden relative w-11 h-11 min-h-[44px] min-w-[44px] flex items-center justify-center rounded-full text-[#B8C0BA] hover:text-[#F4F3ED] hover:bg-white/5 active:scale-95 focus:outline-none focus:ring-2 focus:ring-[#36C98F]/40 cursor-pointer transition-colors"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <div class="w-5 h-4 flex flex-col justify-between pointer-events-none">
          <span
            id="line-top"
            class="w-full h-0.5 bg-[#F4F3ED] rounded-full transition-all duration-300 transform origin-center"
          ></span>
          <span
            id="line-mid"
            class="w-full h-0.5 bg-[#F4F3ED] rounded-full transition-all duration-300"
          ></span>
          <span
            id="line-bot"
            class="w-full h-0.5 bg-[#F4F3ED] rounded-full transition-all duration-300 transform origin-center"
          ></span>
        </div>
      </button>
    </nav>

    <!-- Mobile Dropdown Menu (Synchronized width & natural offset below navbar) -->
    <div
      id="mobile-menu"
      class="md:hidden hidden mt-2 rounded-2xl border border-[#313833] bg-[#171B19]/98 backdrop-blur-2xl p-5 shadow-2xl shadow-black z-40 transition-all duration-300 max-h-[calc(100vh-5.5rem)] overflow-y-auto"
    >
      <div class="flex flex-col gap-2.5 text-base font-medium font-sans">
        <a
          href="#sabores"
          class="mobile-nav-link text-[#B8C0BA] hover:text-[#F4F3ED] min-h-[44px] flex items-center py-2 px-2.5 rounded-lg hover:bg-white/5 border-b border-[#313833]/50 transition-colors"
        >
          Catálogo de Sabores
        </a>
        <a
          href="#planta"
          class="mobile-nav-link text-[#B8C0BA] hover:text-[#F4F3ED] min-h-[44px] flex items-center py-2 px-2.5 rounded-lg hover:bg-white/5 border-b border-[#313833]/50 transition-colors"
        >
          Sede y Planta
        </a>
        <a
          href="#faq"
          class="mobile-nav-link text-[#B8C0BA] hover:text-[#F4F3ED] min-h-[44px] flex items-center py-2 px-2.5 rounded-lg hover:bg-white/5 border-b border-[#313833]/50 transition-colors"
        >
          Preguntas Frecuentes
        </a>

        <a
          href="tel:+573177963888"
          class="mobile-nav-link text-[#36C98F] hover:text-[#2EB37E] min-h-[44px] flex items-center justify-center gap-2 py-2 px-2.5 rounded-lg hover:bg-[#36C98F]/10 border-b border-[#313833]/50 font-semibold transition-colors"
        >
          <span>📞 Llamar: 317 7963888</span>
        </a>

        <a
          href="https://wa.me/573177963888?text=Hola%20ArteFruta,%20deseo%20cotizar%20pulpas%20de%20fruta%20congeladas%20para%20mi%20negocio"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-1 w-full min-h-[46px] flex items-center justify-center gap-2 text-base font-semibold text-[#080A09] bg-[#36C98F] hover:bg-[#2EB37E] active:scale-[0.98] py-3 rounded-full transition-all shadow-md shadow-[#36C98F]/20 cursor-pointer font-sans"
        >
          <span>Cotizar Pedido</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const lineTop = document.getElementById("line-top");
  const lineMid = document.getElementById("line-mid");
  const lineBot = document.getElementById("line-bot");
  const links = document.querySelectorAll(".mobile-nav-link");

  let isOpen = false;

  function openMenu() {
    isOpen = true;
    btn?.setAttribute("aria-expanded", "true");
    menu?.classList.remove("hidden");
    lineTop?.classList.add("translate-y-[7px]", "rotate-45");
    lineMid?.classList.add("opacity-0");
    lineBot?.classList.add("-translate-y-[7px]", "-rotate-45");
  }

  function closeMenu() {
    isOpen = false;
    btn?.setAttribute("aria-expanded", "false");
    menu?.classList.add("hidden");
    lineTop?.classList.remove("translate-y-[7px]", "rotate-45");
    lineMid?.classList.remove("opacity-0");
    lineBot?.classList.remove("-translate-y-[7px]", "-rotate-45");
  }

  btn?.addEventListener("click", (e) => {
    e.stopPropagation();
    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  links.forEach((l) => {
    l.addEventListener("click", () => {
      closeMenu();
    });
  });

  // Close when tapping outside
  document.addEventListener("click", (e) => {
    if (isOpen && !menu?.contains(e.target as Node) && !btn?.contains(e.target as Node)) {
      closeMenu();
    }
  });

  // Close on Escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen) {
      closeMenu();
    }
  });
</script>

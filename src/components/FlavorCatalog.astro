        <div class="rounded-xl bg-[#1F1F1F] border border-neutral-800/90 p-3.5 sm:p-4">
          <strong class="text-white flex items-center gap-2 mb-1 font-semibold">
            <span class="text-base" aria-hidden="true">📦</span>
            <span>Presentaciones Disponibles:</span>
          </strong>
          <p class="text-neutral-300 leading-relaxed">
            Bolsas selladas de <strong>250g</strong>, <strong>500g</strong> y <strong>1.000g</strong> (1 kg). Conservación continua al núcleo a -18°C.
          </p>
        </div>

        <div class="rounded-xl bg-[#1F1F1F] border border-neutral-800/90 p-3.5 sm:p-4">
          <strong class="text-white flex items-center gap-2 mb-1 font-semibold">
            <span class="text-base" aria-hidden="true">🏭</span>
            <span>Capacidad de Planta y Suministro:</span>
          </strong>
          <p class="text-neutral-300 leading-relaxed">
            Línea continua de empaque a <strong>30 pulpas/minuto</strong>. Suministro garantizado desde <strong>1 unidad hasta toneladas</strong> para canal HORECA, cafeterías, casinos y grandes superficies con entregas programadas.
          </p>
        </div>
      </div>

      <div class="pt-4 border-t border-neutral-800 sticky bottom-0 bg-[#181818]/95 backdrop-blur-sm -mx-5 -mb-5 p-5 sm:-mx-7 sm:-mb-7 sm:p-7 rounded-b-2xl">
        <a 
          href="https://wa.me/573177963888?text=Hola%20ArteFruta,%20deseo%20cotizar%20la%20pulpa%20de%20${encodeURIComponent(item.name)}%20para%20mi%20negocio"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2.5 text-sm sm:text-base font-semibold text-slate-900 bg-white hover:bg-neutral-100 active:scale-[0.98] py-3.5 px-6 rounded-full transition-all duration-200 shadow-xl shadow-black/50 border border-neutral-200/70 focus:outline-none focus:ring-2 focus:ring-white/50"
          aria-label="Cotizar pulpa de ${item.name} por WhatsApp"
        >
          <svg class="w-4 h-4 text-emerald-600 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>

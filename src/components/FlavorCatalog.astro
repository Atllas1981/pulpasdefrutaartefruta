---
import { Picture } from 'astro:assets';

import pulpaFresa from '../assets/pulpas/pulpa-fresa.webp';
import pulpaGuayaba from '../assets/pulpas/pulpa-guayaba.webp';
import pulpaLimon from '../assets/pulpas/pulpa-limon.webp';
import pulpaLulo from '../assets/pulpas/pulpa-lulo.webp';
import pulpaMandarina from '../assets/pulpas/pulpa-mandarina.webp';
import pulpaMango from '../assets/pulpas/pulpa-mango.webp';

    category: 'clasicas',
    categoryLabel: 'Clásica y Tradicional',
    image: pulpaMango,
    brix: '13.0 °Bx',
    ph: '4.0',
    profile: 'Textura cremosa y aterciopelada, dulzor natural alto con baja presencia de fibra.',

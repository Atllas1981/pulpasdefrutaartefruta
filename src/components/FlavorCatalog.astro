        </div>
        <div class="rounded-xl bg-black/80 border border-neutral-800 p-3 sm:p-3.5">
          <span class="text-xs uppercase tracking-wider text-neutral-400 block mb-1">Acidez (pH)</span>
          <span class="font-mono-data text-xl font-bold text-cyan-300">${item.ph}</span>

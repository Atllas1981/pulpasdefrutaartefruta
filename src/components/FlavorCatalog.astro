    category: 'clasicas',
    categoryLabel: 'Clásica y Tradicional',
    image: pulpaMaracuya,
    brix: '14.0 °Bx',
    ph: '3.0',
    profile: 'Amarillo dorado vibrante, alta concentración aromática y acidez penetrante tropical.',

      <div class="space-y-3 mb-6 text-sm">
        <div class="rounded-xl bg-[#1F1F1F] border border-neutral-800/90 p-3.5 sm:p-4">
          <strong class="text-white flex items-center gap-2 mb-1 font-semibold">

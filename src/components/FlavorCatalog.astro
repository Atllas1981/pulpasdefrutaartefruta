---

<section id="sabores" class="py-20 sm:py-28 px-4 sm:px-6 bg-[#181818] border-t border-b border-neutral-800 relative">
  <div class="max-w-7xl mx-auto">
    
    <!-- Section Header & Controls -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10 scroll-reveal">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-emerald-400 mb-3">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Catálogo Técnico de Pulpas Ultracongeladas</span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white mb-3 text-wrap:balance">
          10 sabores seleccionados para alta rotación en gastronomía y coctelería
        </h2>
        <p class="text-base sm:text-lg text-neutral-400 text-wrap:pretty leading-relaxed">
          Fichas técnicas estandarizadas con control de grados Brix y acidez. Disponibles en bolsas herméticas de 250g, 500g y 1.000g selladas a -18°C.
        </p>
      </div>

      <!-- Filters & Navigation Controls -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 w-full lg:w-auto">
        <!-- Filter Tabs ([Todas], [Clásicas], [Cítricas]) -->
        <div class="inline-flex p-1.5 rounded-full border border-neutral-800 bg-[#1F1F1F] shadow-inner" role="tablist" aria-label="Filtrar por categoría">
          <button 
            type="button" 
            data-filter="todas"
            class="catalog-filter-btn px-4 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 bg-white text-black shadow-sm"
            role="tab"
            aria-selected="true"
          >
            Todas (10)
          </button>
          <button 
            type="button" 
            data-filter="clasicas"
            class="catalog-filter-btn px-4 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 text-neutral-400 hover:text-white"
            role="tab"
            aria-selected="false"
          >
            Clásicas (7)
          </button>
          <button 
            type="button" 
            data-filter="citricas"
            class="catalog-filter-btn px-4 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 text-neutral-400 hover:text-white"
            role="tab"
            aria-selected="false"
          >
            Cítricas (3)
          </button>
        </div>

        <!-- Carousel Hint & Navigation Controls -->
        <div class="flex items-center gap-3">
          <!-- Visual Drag / Slide Hint Badge -->
          <div id="carousel-drag-hint" class="inline-flex items-center gap-2 text-xs font-semibold text-cyan-300 bg-cyan-950/60 border border-cyan-500/30 rounded-full px-3 py-1.5 shadow-sm transition-opacity duration-500 select-none">
            <span class="flex h-2 w-2 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-400"></span>
            </span>
            <span>Desliza para explorar</span>
            <svg class="w-3.5 h-3.5 text-cyan-300 animate-sway-x" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </div>

          <!-- Carousel Arrow Navigation -->
          <div class="flex items-center gap-2">
            <button 
              id="carousel-prev-btn" 
              type="button" 
              aria-label="Ver sabor anterior en el carrusel"
              class="w-10 h-10 rounded-full border border-neutral-700 bg-[#1F1F1F] text-neutral-300 hover:text-white hover:border-neutral-500 hover:bg-[#272727] active:scale-95 transition-all duration-200 flex items-center justify-center disabled:opacity-40 disabled:cursor-not-allowed shadow-md"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
            </button>

            <span class="font-mono-data text-xs font-semibold text-neutral-400 px-1 min-w-[44px] text-center" id="carousel-counter">
              1 / 10
            </span>

            <button 
              id="carousel-next-btn" 
              type="button" 
              aria-label="Ver siguiente sabor en el carrusel"
              class="w-10 h-10 rounded-full border border-neutral-700 bg-[#1F1F1F] text-neutral-300 hover:text-white hover:border-neutral-500 hover:bg-[#272727] active:scale-95 transition-all duration-200 flex items-center justify-center disabled:opacity-40 disabled:cursor-not-allowed shadow-md"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Carousel Viewport & Track with Edge Fade Shadows -->
    <div class="relative -mx-4 sm:mx-0">
      <div id="carousel-left-shadow" class="pointer-events-none absolute left-0 top-0 bottom-4 w-12 bg-gradient-to-r from-[#181818] to-transparent z-10 opacity-0 transition-opacity duration-300"></div>
      <div id="carousel-right-shadow" class="pointer-events-none absolute right-0 top-0 bottom-4 w-12 bg-gradient-to-l from-[#181818] to-transparent z-10 opacity-100 transition-opacity duration-300"></div>

      <div 
        id="flavor-carousel" 
        class="flex gap-5 sm:gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth px-4 sm:px-0 py-4 scrollbar-none focus:outline-none"
        tabindex="0"
        aria-label="Carrusel de pulpas de fruta ArteFruta"
      >
        {flavors.map((flavor, index) => (
          <article 
            data-category={flavor.category}
            data-index={index + 1}
            class="flavor-card group snap-start flex-none w-[78vw] sm:w-[280px] md:w-[300px] lg:w-[320px] rounded-2xl border border-neutral-800 bg-[#1F1F1F] hover:border-cyan-500/50 hover:bg-[#272727] transition-all duration-300 flex flex-col justify-between overflow-hidden p-4 sm:p-5 shadow-xl shadow-black/50"
          >
            <div>
              <!-- Picture container with cold frost glow & -18°C badge -->
              <div class="relative w-full aspect-[4/3] rounded-xl overflow-hidden bg-black/70 mb-4 border border-neutral-800/90 flex items-center justify-center p-3 group-hover:border-neutral-600 transition-colors shadow-inner">
                <Picture 
                  src={flavor.image} 
                  formats={['webp', 'avif']}
                  widths={[320, 640]}
                  alt={`Pulpa de ${flavor.name} congelada al por mayor en Bucaramanga - ArteFruta`}
                  class="w-full h-full object-contain filter contrast-105 group-hover:scale-105 transition-transform duration-500 ease-out"
                  loading="lazy"
                />
                
                <!-- Temperature Badge -->
                <span class="absolute top-2.5 right-2.5 px-2.5 py-1 rounded-full text-xs font-mono-data font-semibold bg-cyan-950/85 text-cyan-300 border border-cyan-800/80 backdrop-blur-md shadow-sm">
                  -18°C
                </span>
              </div>

              <!-- Commercial Flavor Name -->
              <div class="mb-1.5">
                <h3 class="text-xl sm:text-2xl font-bold text-white group-hover:text-cyan-300 transition-colors tracking-tight text-wrap:balance">
                  {flavor.name}
                </h3>
              </div>

              <!-- Available Presentations in small line -->
              <p class="text-xs text-neutral-400 font-mono-data mb-4">
                250g | 500g | 1.000g
              </p>
            </div>

            <!-- Card Actions -->
            <div class="flex items-center gap-2 pt-3 border-t border-neutral-800/80">
              <!-- Secondary Discrete Button: Ficha técnica 📄 -->
              <button
                type="button"
                class="open-modal-btn flex-1 py-2 px-3 rounded-full text-xs font-semibold text-neutral-300 hover:text-white bg-[#181818] hover:bg-[#272727] border border-neutral-700/80 active:scale-95 transition-all duration-200 text-center shadow-sm flex items-center justify-center gap-1.5 focus:outline-none focus:ring-2 focus:ring-cyan-500/40 cursor-pointer"
                data-flavor-id={flavor.id}
                aria-label={`Ver ficha técnica de pulpa de ${flavor.name}`}
              >
                <span>Ficha técnica</span>
                <span aria-hidden="true">📄</span>
              </button>

              <!-- Primary Pill Button: Fondo blanco limpio con texto oscuro e ícono WhatsApp -->
              <a 
                href={`https://wa.me/573177963888?text=Hola%20ArteFruta,%20deseo%20cotizar%20la%20pulpa%20de%20${encodeURIComponent(flavor.name)}%20para%20mi%20negocio`}
                target="_blank"
                rel="noopener noreferrer"
                class="py-2 px-3.5 rounded-full text-xs font-semibold text-neutral-900 bg-white hover:bg-neutral-100 active:scale-95 transition-all duration-200 inline-flex items-center gap-1.5 shadow-md shadow-black/40 border border-neutral-200/60 shrink-0 focus:outline-none focus:ring-2 focus:ring-white/40"
                aria-label={`Cotizar pulpa de ${flavor.name} por WhatsApp`}
              >
                <svg class="w-3.5 h-3.5 text-emerald-600 fill-current" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
                <span>Cotizar</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Carousel Progress Bar -->
      <div class="mt-6 hidden sm:block w-full max-w-md mx-auto bg-neutral-800/80 rounded-full h-1 overflow-hidden">
        <div id="carousel-progress" class="bg-cyan-400 h-full w-[10%] rounded-full transition-all duration-300"></div>
      </div>
    </div>

  </div>

  <!-- Technical Modal for Detailed Flavor Inspection -->
  <div 
    id="tech-modal" 
    class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-md flex items-center justify-center p-3 sm:p-4 transition-all duration-300"
    aria-hidden="true"
    role="dialog"
    aria-labelledby="modal-title"
  >
    <div class="relative w-full max-w-xl rounded-2xl border border-neutral-700 bg-[#181818] shadow-2xl max-h-[85vh] overflow-y-auto overscroll-contain flex flex-col p-5 sm:p-7 focus:outline-none scrollbar-thin">
      <!-- Sticky Close Button Container to guarantee instant accessibility on mobile -->
      <div class="sticky top-0 z-20 flex justify-end pointer-events-none -mt-2 -mr-2 mb-2">
        <button 
          id="close-modal-btn"
          type="button" 
          class="pointer-events-auto bg-[#272727]/90 hover:bg-[#313131] border border-neutral-600/80 text-neutral-300 hover:text-white p-2 rounded-full backdrop-blur-md transition-all duration-200 active:scale-95 shadow-lg focus:outline-none focus:ring-2 focus:ring-cyan-500/40 cursor-pointer"
          aria-label="Cerrar ficha técnica"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div id="modal-content" class="flex-1">
        <!-- Injected via JavaScript -->
      </div>
    </div>
  </div>
</section>

<style>
  /* Clean horizontal scrollbar concealment */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Micro-animation for horizontal drag/slide hint */
  @keyframes swayX {
    0%, 100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(5px);
    }
  }
  .animate-sway-x {
    animation: swayX 1.4s cubic-bezier(0.32, 0.72, 0, 1) infinite;
  }

  /* Sleek scrollbar for the modal dialog */
  .scrollbar-thin {
    scrollbar-width: thin;
    scrollbar-color: #3f3f46 transparent;
  }
  .scrollbar-thin::-webkit-scrollbar {
    width: 6px;
  }
  .scrollbar-thin::-webkit-scrollbar-track {
    background: transparent;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb {
    background: #3f3f46;
    border-radius: 9999px;
  }
</style>

<!-- Serialized flavors data for client-side modal and carousel navigation -->
<script define:vars={{ flavorsData: flavors }}>
  const carousel = document.getElementById('flavor-carousel');
  const prevBtn = document.getElementById('carousel-prev-btn');
  const nextBtn = document.getElementById('carousel-next-btn');
  const counter = document.getElementById('carousel-counter');
  const progressBar = document.getElementById('carousel-progress');
  const filterBtns = document.querySelectorAll('.catalog-filter-btn');
  const cards = document.querySelectorAll('.flavor-card');
  const leftShadow = document.getElementById('carousel-left-shadow');
  const rightShadow = document.getElementById('carousel-right-shadow');
  const dragHint = document.getElementById('carousel-drag-hint');
  const floatingWhatsApp = document.getElementById('floating-whatsapp');

  let currentCategory = 'todas';

  // Function to get currently visible cards
  function getVisibleCards() {
    return Array.from(cards).filter(card => !card.classList.contains('hidden'));
  }

  // Update counter & progress bar based on scroll position
  function updateCarouselState() {
    if (!carousel) return;
    const visibleCards = getVisibleCards();
    const total = visibleCards.length;
    if (total === 0) return;

    const scrollLeft = carousel.scrollLeft;
    const scrollWidth = carousel.scrollWidth - carousel.clientWidth;
    const cardWidth = visibleCards[0]?.offsetWidth || 300;
    
    // Calculate approximate active card index
    const currentIndex = Math.min(
      total,
      Math.max(1, Math.round(scrollLeft / cardWidth) + 1)
    );

    if (counter) {
      counter.textContent = `${currentIndex} / ${total}`;
    }

    if (progressBar) {
      const progressPercent = scrollWidth > 0 
        ? Math.min(100, Math.max(10, ((scrollLeft / scrollWidth) * 100))) 
        : 100;
      progressBar.style.width = `${progressPercent}%`;
    }

    if (prevBtn) {
      prevBtn.disabled = scrollLeft <= 10;
    }
    if (nextBtn) {
      nextBtn.disabled = scrollLeft >= (scrollWidth - 10);
    }

    // Dynamic edge fade shadows
    if (leftShadow) {
      leftShadow.style.opacity = scrollLeft > 15 ? '1' : '0';
    }
    if (rightShadow) {
      rightShadow.style.opacity = scrollLeft >= (scrollWidth - 15) ? '0' : '1';
    }

    // Gentle fade of drag hint on user interaction
    if (dragHint) {
      dragHint.style.opacity = scrollLeft > 40 ? '0.4' : '1';
    }
  }

  // Next & Prev scroll handlers
  function scrollCarousel(direction) {
    if (!carousel) return;
    const visibleCards = getVisibleCards();
    if (visibleCards.length === 0) return;
    
    const cardWidth = visibleCards[0].offsetWidth + 20; // card width + gap
    carousel.scrollBy({
      left: direction * cardWidth,
      behavior: 'smooth'
    });
  }

  prevBtn?.addEventListener('click', () => scrollCarousel(-1));
  nextBtn?.addEventListener('click', () => scrollCarousel(1));

  carousel?.addEventListener('scroll', updateCarouselState, { passive: true });

  // Vaivén (peek & slide back motion cue) when catalog scrolls into view
  let hasTriggeredVaiven = false;
  const vaivenObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !hasTriggeredVaiven) {
        hasTriggeredVaiven = true;
        setTimeout(() => {
          if (carousel && carousel.scrollLeft <= 10) {
            // Smoothly peek forward 80px to hint at more cards
            carousel.scrollBy({ left: 80, behavior: 'smooth' });
            // Slide back to initial card creating the natural vaivén
            setTimeout(() => {
              carousel.scrollTo({ left: 0, behavior: 'smooth' });
            }, 600);
          }
        }, 400);
      }
    });
  }, { threshold: 0.25 });

  if (carousel) {
    vaivenObserver.observe(carousel);
  }

  // Keyboard navigation for carousel
  carousel?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') {
      scrollCarousel(-1);
    } else if (e.key === 'ArrowRight') {
      scrollCarousel(1);
    }
  });

  // Filter Tabs Handler
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');
      currentCategory = filter;

      // Update button visual states
      filterBtns.forEach(b => {
        b.classList.remove('bg-white', 'text-black', 'shadow-sm');
        b.classList.add('text-neutral-400');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('bg-white', 'text-black', 'shadow-sm');
      btn.classList.remove('text-neutral-400');
      btn.setAttribute('aria-selected', 'true');

      // Filter visible cards
      cards.forEach(card => {
        const cat = card.getAttribute('data-category');
        if (filter === 'todas' || cat === filter) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });

      // Smooth reset scroll to first slide
      if (carousel) {
        carousel.scrollTo({ left: 0, behavior: 'smooth' });
      }

      setTimeout(updateCarouselState, 150);
    });
  });


    variety: 'De Castilla',
    category: 'clasicas',
    categoryLabel: 'Clásica y Tradicional',
    image: pulpaMora,
    brix: '9.0 °Bx',
    ph: '3.2',
    profile: 'Púrpura profundo, astringencia frutal característica y equilibrada acidez natural.',
    applications: 'Jugos institucionales, reducciones para carnes rojas, repostería y sodas saborizadas.',
    yield: 'Intensidad de color que mantiene presencia viva aun diluido.'
  },

interface Flavor {
  id: string;
  name: string;
  variety: string;
  category: 'clasicas' | 'citricas';
  categoryLabel: string;
  image: ImageMetadata;
  brix: string;
  ph: string;
  profile: string;
  applications: string;
  yield: string;
}

const flavors: Flavor[] = [
  {
    id: 'fresa',
    name: 'Fresa',
    variety: 'Silvestre',
    category: 'clasicas',
    categoryLabel: 'Clásica y Tradicional',
    image: pulpaFresa,
    brix: '8.0 °Bx',
    ph: '3.4',
    profile: 'Rojo rubí brillante, aroma intenso y acidez moderada con textura homogénea.',
    applications: 'Batidos, frappés, mermeladas artesanales, coulis de pastelería y daiquiris.',
    yield: 'Alto rendimiento en coctelería y batidos lácteos sin cortar la leche.'
  },
  {
    id: 'mora',

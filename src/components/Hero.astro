---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Video paths (supporting both WebM and MP4 for universal mobile and desktop playback)
const videoDesktopWebm = `${base}/video/hero-fruta-congelada-loop.webm`;
const videoDesktopMp4 = `${base}/video/hero-fruta-congelada-loop.mp4`;
const posterDesktop = `${base}/video/hero-video-poster.webp`;

const videoMobileWebm = `${base}/video/hero-fruta-congelada-loop-movil.webm`;
const videoMobileMp4 = `${base}/video/hero-fruta-congelada-loop-movil.mp4`;
const posterMobile = `${base}/video/hero-video-poster-movil.webp`;
---

<section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden pt-28 pb-16 px-4 sm:px-6">
  <!-- Background Video with Vivid Cold Loop (Responsive Mobile & Desktop) -->
  <div class="absolute inset-0 w-full h-full z-0 overflow-hidden">
    <!-- Desktop Video (screens md: 768px and up) -->
    <video 
      id="hero-video-desktop"
      class="hidden md:block w-full h-full object-cover scale-105 opacity-90 brightness-100 contrast-105 saturate-115 transition-opacity duration-1000"
      autoplay 
      loop 
      muted 
      playsinline
      webkit-playsinline
      poster={posterDesktop}
      preload="auto"
    >
      <source src={videoDesktopWebm} type="video/webm" />
      <source src={videoDesktopMp4} type="video/mp4" />
    </video>

    <!-- Mobile Video (screens below md: 768px) -->
    <video 
      id="hero-video-mobile"
      class="block md:hidden w-full h-full object-cover scale-105 opacity-85 brightness-100 contrast-105 saturate-115 transition-opacity duration-1000"
      autoplay 
      loop 
      muted 
      playsinline
      webkit-playsinline
      poster={posterMobile}
      preload="auto"
    >
      <source src={videoMobileWebm} type="video/webm" />
      <source src={videoMobileMp4} type="video/mp4" />
    </video>

    <!-- High-Contrast Dark Overlay: Softens video noise/labels while maintaining fruit movement -->
    <div class="hero-overlay-1 absolute inset-0 bg-gradient-to-b from-[#080A09]/40 via-[#080A09]/15 to-[#080A09]/55 pointer-events-none"></div>
    <div class="hero-overlay-2 absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(8,10,9,0.20)_0%,_rgba(8,10,9,0.05)_60%,_rgba(8,10,9,0.35)_100%)] pointer-events-none"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-cyan-950/25 via-transparent to-transparent pointer-events-none"></div>
    <!-- Bottom smooth blending into catalog section -->
    <div class="absolute bottom-0 inset-x-0 h-28 bg-gradient-to-t from-[#080A09] via-[#080A09]/80 to-transparent pointer-events-none"></div>
  </div>

  <!-- Content Container -->
  <div class="hero-content relative z-10 max-w-5xl mx-auto flex flex-col items-center text-center">
    
    <!-- Cold Frost Badge: Cian Técnico #55D6E8 -->
    <div class="hero-badge inline-flex items-center gap-2 rounded-full border border-[#55D6E8]/35 bg-[#171B19]/90 px-3.5 py-1.5 text-xs sm:text-sm font-medium text-[#55D6E8] backdrop-blur-md mb-6 shadow-xl shadow-black/50 font-sans">
      <span class="inline-block w-2 h-2 rounded-full bg-[#55D6E8] animate-pulse"></span>
      <span class="font-mono-data tracking-wide font-semibold text-[#55D6E8]">-18°C al núcleo</span>
      <span class="text-[#313833]">|</span>
      <span>Cadena de frío para gastronomía y coctelería</span>
    </div>

    <!-- Main Headline with Manrope 700 & High Legibility Solid Text + Drop Shadow -->
    <h1 class="hero-title text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight max-w-[760px] leading-[1.12] text-wrap:balance mb-6 text-[#F4F3ED] font-heading">
      Pulpas de fruta al por mayor en Bucaramanga para restaurantes, cafeterías y barras
    </h1>

    <!-- Subtitle: Crisp High-Contrast Text with Strong Contrast and Soft Scrim Backdrop -->
    <p class="hero-subtitle text-base sm:text-lg text-[#F4F3ED] font-medium max-w-[680px] text-wrap:pretty leading-relaxed mb-8 font-sans px-2">
      Estandariza el rendimiento, acidez y dulzor en cocina y coctelería profesional. Sin aditivos, sin mermas y con capacidad de empaque de 30 unidades por minuto.
    </p>

    <!-- CTAs: One primary CTA in Verde Esmeralda #36C98F, one secondary link -->
    <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto mb-14">
      <a 
        href="https://wa.me/573177963888?text=Hola%20ArteFruta,%20deseo%20cotizar%20pulpas%20de%20fruta%20para%20mi%20negocio" 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 text-base font-semibold text-[#080A09] bg-[#36C98F] hover:bg-[#2EB37E] active:scale-[0.98] py-2.5 px-6 rounded-full transition-all duration-200 shadow-xl shadow-[#36C98F]/25 font-sans group"
      >
        <svg class="w-5 h-5 text-[#080A09] fill-current group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>Solicitar cotización por WhatsApp</span>
      </a>

      <a 
        href="#sabores" 
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 text-base font-semibold text-[#F4F3ED] hover:text-white bg-[#171B19]/80 hover:bg-[#171B19] backdrop-blur-md border border-[#313833] hover:border-[#F4F3ED] py-2.5 px-5 rounded-full transition-all duration-200 shadow-lg font-sans"
      >
        <span>Ver catálogo y fichas técnicas</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </a>
    </div>

    <!-- Proof Strip / Data Metrics: Colores funcionales (#55D6E8 ultracongelación, #F5B942 métricas) -->
    <div class="w-full grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 max-w-4xl">
      <div class="rounded-2xl border border-[#313833] bg-[#171B19]/90 backdrop-blur-md p-4 text-left shadow-xl shadow-black/60">
        <div class="font-mono-data text-2xl sm:text-3xl font-bold text-[#55D6E8] mb-1">-18°C</div>
        <div class="text-xs sm:text-sm text-[#B8C0BA] font-medium font-sans">Ultracongelación al núcleo</div>
      </div>

      <div class="rounded-2xl border border-[#313833] bg-[#171B19]/90 backdrop-blur-md p-4 text-left shadow-xl shadow-black/60">
        <div class="font-mono-data text-2xl sm:text-3xl font-bold text-[#F5B942] mb-1">30/min</div>
        <div class="text-xs sm:text-sm text-[#B8C0BA] font-medium font-sans">Empaque automatizado</div>
      </div>

      <div class="rounded-2xl border border-[#313833] bg-[#171B19]/90 backdrop-blur-md p-4 text-left shadow-xl shadow-black/60">
        <div class="font-mono-data text-2xl sm:text-3xl font-bold text-[#36C98F] mb-1">100%</div>
        <div class="text-xs sm:text-sm text-[#B8C0BA] font-medium font-sans">Fruta natural sin aditivos</div>
      </div>

      <div class="rounded-2xl border border-[#313833] bg-[#171B19]/90 backdrop-blur-md p-4 text-left shadow-xl shadow-black/60">
        <div class="font-mono-data text-2xl sm:text-3xl font-bold text-[#F5B942] mb-1">6 Dptos</div>
        <div class="text-xs sm:text-sm text-[#B8C0BA] font-medium font-sans">Cobertura interdepartamental</div>
      </div>
    </div>

  </div>
</section>

<script>
  function initHeroVideos() {
    const desktopVideo = document.getElementById('hero-video-desktop') as HTMLVideoElement | null;
    const mobileVideo = document.getElementById('hero-video-mobile') as HTMLVideoElement | null;

    if (!desktopVideo && !mobileVideo) return;

    const playVideo = (v: HTMLVideoElement | null) => {
      if (!v) return;
      v.muted = true;
      v.defaultMuted = true;
      // Force load before playing
      if (v.readyState === 0) v.load();
      const promise = v.play();
      if (promise !== undefined) {
        promise.catch(() => {
          // Touch/click listener if mobile browser strictly requires first user gesture
          const onFirstInteraction = () => {
            v.play().catch(() => {});
          };
          window.addEventListener('touchstart', onFirstInteraction, { once: true, passive: true });
          window.addEventListener('click', onFirstInteraction, { once: true, passive: true });
        });
      }
    };

    const handlePlayback = () => {
      if (window.innerWidth >= 768) {
        if (mobileVideo && !mobileVideo.paused) mobileVideo.pause();
        playVideo(desktopVideo);
      } else {
        if (desktopVideo && !desktopVideo.paused) desktopVideo.pause();
        playVideo(mobileVideo);
      }
    };

    handlePlayback();
    window.addEventListener('resize', handlePlayback, { passive: true });
  }

  // Run on initial load and after Astro View Transitions
  document.addEventListener('astro:page-load', initHeroVideos);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroVideos);
  } else {
    initHeroVideos();
  }
</script>

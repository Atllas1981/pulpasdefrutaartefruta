---
---

<section id="logistica" class="py-24 sm:py-32 px-4 sm:px-6 bg-black">
  <div class="max-w-6xl mx-auto">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-16 scroll-reveal">
      <div class="text-xs font-semibold uppercase tracking-wider text-cyan-400 mb-3">
        Cadena de Frío y Distribución
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white mb-4">
        Logística interdepartamental con control térmico a -18°C
      </h2>
      <p class="text-base sm:text-lg text-neutral-400">
        Despachos locales diarios en Bucaramanga y envíos protegidos hacia 5 departamentos de la región Caribe y Santanderes.
      </p>
    </div>

    <!-- Coverage Grid: Bucaramanga + 5 Departments -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-16">
      
      <!-- Local Coverage Card -->
      <div class="rounded-2xl border border-neutral-800 bg-[#181818] p-6 sm:p-8 flex flex-col justify-between scroll-reveal">
        <div>
          <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-emerald-950/80 text-emerald-300 border border-emerald-800/60 mb-4">
            Ruta Local Express
          </span>
          <h3 class="text-xl sm:text-2xl font-bold text-white mb-3">
            Área Metropolitana de Bucaramanga
          </h3>
          <p class="text-neutral-400 text-sm leading-relaxed mb-6">
            Atención prioritaria y despachos programados directo desde nuestra sede en Centro Abastos para establecimientos del área metropolitana.
          </p>
          <ul class="space-y-2 text-sm text-neutral-300 mb-6">
            <li class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold">•</span>
              <span>Bucaramanga (Centro, Cabecera, Provenza, Norte)</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold">•</span>
              <span>Floridablanca y Cañaveral</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold">•</span>
              <span>Girón</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold">•</span>
              <span>Piedecuesta</span>
            </li>
          </ul>
        </div>
        <div class="rounded-xl bg-black/60 border border-neutral-800 p-3 text-xs text-neutral-400">
          Entregas refrigeradas ágiles para no interrumpir tu servicio en cocina.
        </div>
      </div>

      <!-- Regional & Interdepartamental Coverage Card -->
      <div class="lg:col-span-2 rounded-2xl border border-neutral-800 bg-[#181818] p-6 sm:p-8 flex flex-col justify-between scroll-reveal">
        <div>
          <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-cyan-950/80 text-cyan-300 border border-cyan-800/60 mb-4">
            Despachos Interdepartamentales
          </span>
          <h3 class="text-xl sm:text-2xl font-bold text-white mb-3">
            Conexión con el Oriente y la Costa Caribe
          </h3>
          <p class="text-neutral-400 text-sm leading-relaxed mb-6">
            Despachamos pedidos mayoristas con transportadoras especializadas de frío y rutas nocturnas para asegurar que el producto llegue congelado a su destino final.
          </p>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-6">
            <div class="rounded-xl bg-black border border-neutral-800 p-3 text-left">
              <span class="text-xs text-neutral-400 block">Departamento</span>
              <strong class="text-sm text-white">Norte de Santander</strong>
              <span class="text-[11px] text-cyan-400 block mt-0.5">Cúcuta y provincia</span>
            </div>
            <div class="rounded-xl bg-black border border-neutral-800 p-3 text-left">
              <span class="text-xs text-neutral-400 block">Departamento</span>
              <strong class="text-sm text-white">Cesar</strong>
              <span class="text-[11px] text-cyan-400 block mt-0.5">Valledupar y corredor</span>
            </div>
            <div class="rounded-xl bg-black border border-neutral-800 p-3 text-left">
              <span class="text-xs text-neutral-400 block">Departamento</span>
              <strong class="text-sm text-white">Magdalena</strong>
              <span class="text-[11px] text-cyan-400 block mt-0.5">Santa Marta y región</span>
            </div>
            <div class="rounded-xl bg-black border border-neutral-800 p-3 text-left">
              <span class="text-xs text-neutral-400 block">Departamento</span>
              <strong class="text-sm text-white">Bolívar</strong>
              <span class="text-[11px] text-cyan-400 block mt-0.5">Cartagena y zona hotelera</span>
            </div>
            <div class="rounded-xl bg-black border border-neutral-800 p-3 text-left">
              <span class="text-xs text-neutral-400 block">Departamento</span>
              <strong class="text-sm text-white">Atlántico</strong>
              <span class="text-[11px] text-cyan-400 block mt-0.5">Barranquilla y costa</span>
            </div>
            <div class="rounded-xl bg-black border border-neutral-800 p-3 text-left">
              <span class="text-xs text-neutral-400 block">Política</span>
              <strong class="text-sm text-amber-300">Flete al cobro</strong>
              <span class="text-[11px] text-neutral-400 block mt-0.5">Asumido por cliente</span>
            </div>
          </div>
        </div>
        <div class="rounded-xl bg-black/60 border border-neutral-800 p-3.5 text-xs text-neutral-300 flex items-center justify-between">
          <span>* Fletes asumidos por el cliente con tarifas preferenciales en frío.</span>
          <a href="https://wa.me/573177963888?text=Hola%20ArteFruta,%20deseo%20consultar%20tiempos%20de%20envio%20a%20mi%20ciudad" target="_blank" rel="noopener noreferrer" class="text-white hover:text-cyan-300 underline font-medium">Consultar ruta</a>
        </div>
      </div>

    </div>

    <!-- Packaging Options (3 Pricing Cards) -->
    <div class="mb-8 scroll-reveal">
      <div class="text-xs font-semibold uppercase tracking-wider text-neutral-400 mb-2">
        Protección Térmica de Viaje
      </div>
      <h3 class="text-2xl sm:text-3xl font-bold text-white mb-2">
        Opciones de empaque y embalaje según distancia
      </h3>
      <p class="text-sm text-neutral-400">
        Elige la configuración de embalaje adecuada según la duración del trayecto para garantizar la ultracongelación al núcleo.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Option 1: Carton -->
      <div class="rounded-2xl border border-neutral-800 bg-[#181818] p-6 sm:p-7 flex flex-col justify-between scroll-reveal">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs uppercase tracking-wider font-semibold text-neutral-400">Trayectos Cortos</span>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-neutral-800 text-neutral-300">Caja Estándar</span>
          </div>
          <h4 class="text-xl font-bold text-white mb-2">
            Caja de cartón reforzada
          </h4>
          <p class="text-sm text-neutral-400 mb-6">
            Empaque óptimo para despachos de madrugada o traslados de corto alcance con recepción inmediata.
          </p>
          <div class="mb-6">
            <div class="font-mono-data text-3xl font-bold text-white mb-1">$0 COP</div>
            <span class="text-xs text-emerald-400 font-medium">Incluido sin costo adicional</span>
          </div>
        </div>
        <ul class="space-y-2 text-xs text-neutral-300 border-t border-neutral-800 pt-4">
          <li class="flex items-center gap-1.5">
            <span class="text-emerald-400">✓</span>
            <span>Sellado hermético perimetral</span>
          </li>
          <li class="flex items-center gap-1.5">
            <span class="text-emerald-400">✓</span>
            <span>Recomendado: despachos de madrugada</span>
          </li>
        </ul>
      </div>

      <!-- Option 2: Cava de segunda -->
      <div class="rounded-2xl border border-neutral-800 bg-[#181818] p-6 sm:p-7 flex flex-col justify-between scroll-reveal">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs uppercase tracking-wider font-semibold text-cyan-400">Trayectos Medios</span>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-cyan-950 text-cyan-300 border border-cyan-800/50">Estado 8/10</span>
          </div>
          <h4 class="text-xl font-bold text-white mb-2">
            Cava de icopor recuperada
          </h4>
          <p class="text-sm text-neutral-400 mb-6">
            Aislamiento térmico de alta densidad verificado, limpio y apto para viajes interdepartamentales de distancia media.
          </p>
          <div class="mb-6">
            <div class="font-mono-data text-3xl font-bold text-cyan-300 mb-1">$50.000 COP</div>
            <span class="text-xs text-neutral-400 font-medium">Opción económica y reutilizable</span>
          </div>
        </div>
        <ul class="space-y-2 text-xs text-neutral-300 border-t border-neutral-800 pt-4">
          <li class="flex items-center gap-1.5">
            <span class="text-cyan-400">✓</span>
            <span>Conservación hasta 24 horas</span>
          </li>
          <li class="flex items-center gap-1.5">
            <span class="text-cyan-400">✓</span>
            <span>Inspección de integridad previa</span>
          </li>
        </ul>
      </div>

      <!-- Option 3: Cava nueva 10/10 (Recommended for long trips) -->
      <div class="rounded-2xl border-2 border-cyan-500/80 bg-[#181818] p-6 sm:p-7 flex flex-col justify-between relative shadow-xl shadow-cyan-950/30 scroll-reveal">
        <span class="absolute -top-3 right-6 px-3 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-cyan-400 text-black">
          Recomendada viajes largos
        </span>
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs uppercase tracking-wider font-semibold text-cyan-300">Trayectos Largos</span>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-neutral-900 text-white border border-neutral-700">Nueva 10/10</span>
          </div>
          <h4 class="text-xl font-bold text-white mb-2">
            Cava de icopor nueva termoaislante
          </h4>
          <p class="text-sm text-neutral-400 mb-6">
            Máxima retención térmica recomendada para traslados hacia Bolívar, Atlántico y Magdalena en clima cálido.
          </p>
          <div class="mb-6">
            <div class="font-mono-data text-3xl font-bold text-white mb-1">$90.000 COP</div>
            <span class="text-xs text-cyan-300 font-medium">Retención térmica de grado industrial</span>
          </div>
        </div>
        <ul class="space-y-2 text-xs text-neutral-300 border-t border-neutral-800 pt-4">
          <li class="flex items-center gap-1.5">
            <span class="text-cyan-400">✓</span>
            <span>Garantiza -18°C al núcleo en ruta</span>
          </li>
          <li class="flex items-center gap-1.5">
            <span class="text-cyan-400">✓</span>
            <span>Estructura virgen 100% sellada</span>
          </li>
        </ul>
      </div>

    </div>

  </div>
</section>
